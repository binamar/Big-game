{
  "id": "chapter_10",
  "number": 10,
  "title": "The Open Ledger",
  "subtitle": "Charter Reckoning",
  "summary": "In the final Council assembly, every collected witness, receipt, and saved archive decides the future of the Guild.",
  "startNode": "c10_start",
  "nextChapterId": null,
  "nodes": {
    "c10_start": {
      "id": "c10_start",
