        { "id": "orsen", "expression": "neutral", "position": "right", "active": false }
      ],
      "text": "Got all four barge registries—and the dock hand just handed Myra his coerced slip in exchange for keeping his name clear of the riot.",
      "next": "c2_reunion_proof"
    },
    "c2_road_toll_1": {
