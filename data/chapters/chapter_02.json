        { "id": "orsen", "expression": "angry", "position": "right", "active": true }
      ],
      "text": "Say the word, clerk, and I'll drop that pry-bar across the gangplank—or we pin down their hull numbers from the shadow.",
      "next": "c2_alley_subchoice"
    },
