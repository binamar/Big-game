        { "id": "orsen", "expression": "angry", "position": "right", "active": false }
      ],
      "text": "Keep beneath the shuttered eaves. Beneath that swinging iron lantern—three dock hands hauling iron crates labeled 'Winter Barley.'",
      "next": "c2_road_alley_orsen"
    },
    "c2_road_alley_orsen": {
      "id": "c2_road_alley_orsen",
      "backdrop": "night_alley",
