        { "id": "orsen", "expression": "determined", "position": "right", "active": false }
      ],
      "text": "Dusk is falling fast over the river bend. Two paths lead into the lower lockhouse quarter—how do we strike?",
      "choices": [
        {
          "label": "Road A: Slip down the brick night alley to catch the barge loaders red-handed",
