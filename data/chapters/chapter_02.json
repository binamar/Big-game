        { "id": "myra", "expression": "neutral", "position": "right", "active": false }
      ],
      "text": "Inside the lockhouse alley, the night clerk nearly drops his inkpot when Myra bars the back shutter and Orsen blocks the doorway.",
      "next": "c2_toll_clerk_plea"
    },
    "c2_toll_clerk_plea": {
      "id": "c2_toll_clerk_plea",
