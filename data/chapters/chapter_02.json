        { "id": "orsen", "expression": "determined", "position": "center", "active": true },
        { "id": "myra", "expression": "worried", "position": "right", "active": false }
      ],
      "text": "Your call, clerk. Either offer the poor fellow sanctuary in exchange for sworn testimony, or confiscate his lockhouse book outright.",
      "choices": [
        {
          "label": "Promise the clerk Outer Ward shelter if he testifies at dawn",
          "next": "c2_toll_spared",
