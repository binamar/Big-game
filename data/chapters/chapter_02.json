          "setFlags": { "valley_road_alley": true },
          "addScore": { "guild_standing": 1 }
        },
        {
          "label": "Road B: Corner the lockhouse toll-shed clerk directly using our audit proof",
          "next": "c2_road_toll_1",
          "setFlags": { "valley_road_alley": false },
          "addScore": { "guild_standing": 1 }
        }
      ]
    },
    "c2_road_alley_1": {
