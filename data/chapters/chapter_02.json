        { "id": "orsen", "expression": "angry", "position": "right", "active": true, "shake": true }
      ],
      "text": "Drop those ropes! Every crate on that plank belongs to the Outer Ward forge—and the foreman drops the manifest ledger on the cobblestones as his crew bolts!",
      "next": "c2_reunion_proof"
    },
