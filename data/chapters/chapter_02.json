        { "id": "orsen", "expression": "tired", "position": "center", "active": false },
        { "id": "myra", "expression": "worried", "position": "right", "active": true }
      ],
      "text": "He's shaking like a dry leaf, Torrik. Says Quartermaster enforcers threatened his family's winter rations if he logged the barges.",
      "next": "c2_toll_choice"
    },
